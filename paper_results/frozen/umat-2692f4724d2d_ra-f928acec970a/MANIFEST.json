  "tolerances": {
    "derivative_relative_tolerance": {
      "applies_to": "OTI derivative against its independent reference",
      "justification": "A centred difference at a well-chosen step resolves a smooth derivative to roughly 1e-8 relative; 1e-6 leaves two decades of margin for the reference's own truncation without admitting a genuine transformation error. It is never widened to recover a result: a row the reference cannot resolve at this tolerance is reported as unresolved, not as agreement.",
      "value": 1e-06
    },
    "finite_difference_default_relative_step": {
      "applies_to": "first-pass centred-difference reference",
      "justification": "A first pass only. Where a row disagrees, the step is chosen from the method's own convergence over a ladder spanning 1e-2 to 1e-7 rather than fixed in advance, because a fixed step is a guess about the model's third derivative.",
      "value": 0.0001
    },
    "finite_difference_noise_floor": {
      "applies_to": "whether the reference can adjudicate a row at all",
      "expression": "eps * max(|response_scale|, 1) / (2h)",
      "justification": "Models cancellation only. Truncation is handled separately by the step-convergence study, because the two dominate in opposite step regimes."
    },
    "primal_parity_relative_tolerance": {
      "applies_to": "stress and state of the original vs transformed build",
      "justification": "The two builds run the same algorithm in different arithmetic, so they should agree to near machine precision; 1e-9 catches a genuine divergence while tolerating reassociation. Measured values sit at 1e-14 to 1e-16, far inside it.",
      "value": 1e-09
    }
  },
